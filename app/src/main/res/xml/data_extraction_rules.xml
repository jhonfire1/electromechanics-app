<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de respaldo para Android 12 o superior (API >= 31).
   Se excluye la base de datos Room de la copia en la nube y de la transferencia entre dispositivos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
